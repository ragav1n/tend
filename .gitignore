# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. .env* catches .env.local and friends; the example is the one file
# that must be committed, since README tells you to copy it.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# the service worker, built from app/sw.ts by `npm run build`. Generated output
# with a precache manifest of hashed asset names, so committing it means
# committing a file that is wrong the moment anything else changes.
/public/sw.js
/public/sw.js.map
