# Copy to .env.local (or .env) and fill in. This file is committed, so it holds
# names and explanations only. Never paste a real value here.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Project settings -> API. Newer projects issue a publishable key; older ones
# call it the anon key. Either is safe in the browser, because RLS is what
# protects the data and every policy is scoped to (select auth.uid()).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS entirely. Used by the cron route and the Resend
# webhook, and never imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Cron ────────────────────────────────────────────────────────────────────
# Shared secret checked by /api/cron/*. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value goes into Supabase Vault as `cron_secret`, never inline in
# cron.schedule, because cron.job.command is readable by anyone who can read the
# cron schema.
CRON_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# onboarding@resend.dev only delivers to your own Resend account address, which
# is a natural sandbox. Swap in reminders@mail.yourdomain.com once the domain is
# verified; nothing else changes.
EMAIL_FROM="Tend <onboarding@resend.dev>"

# off      -> route short-circuits, sends nothing. The default outside production.
# console  -> renders and logs the HTML, marks rows sent, no network.
# catchall -> rewrites every recipient to EMAIL_DEV_INBOX.
# live     -> actually sends.
EMAIL_MODE=off
EMAIL_DEV_INBOX=
EMAIL_DEV_ALLOWED_DOMAINS=

# Signs the unsubscribe and preference-centre links. Separate from every other
# secret so it can be rotated on its own.
EMAIL_TOKEN_SECRET=

# Resend webhook signature verification (Svix).
RESEND_WEBHOOK_SECRET=

# ─── Web push ────────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
