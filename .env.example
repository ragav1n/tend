# Tend environment. Names and comments only, never values: this repo is public.
# Copy to .env.local, which is gitignored, and fill it in there.

# ── Supabase ────────────────────────────────────────────────────────────────
# Both come from Project Settings > API in the Supabase dashboard. The second
# is what Supabase used to call the anon key and now calls the publishable key.
# It is safe in the browser because every table has RLS and every policy is a
# bare comparison on user_id. Safe to expose is not the same as a licence to
# skip RLS on a new table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS entirely, so it must never be prefixed NEXT_PUBLIC_
# and never imported into a client component. Phase 1 does not use it: both sync
# RPCs are SECURITY INVOKER and run under the user's own session. It is here for
# the phase 2 purge cron.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Phase 2, reminders. Not read yet. ───────────────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=onboarding@resend.dev
# EMAIL_MODE=off
# CRON_SECRET=
