# Tend environment. Names and comments only, never values: this repo is public.
# Copy to .env.local, which is gitignored, and fill it in there.

# ── Supabase ────────────────────────────────────────────────────────────────
# Both come from Project Settings > API in the Supabase dashboard. The second
# is what Supabase used to call the anon key and now calls the publishable key.
# It is safe in the browser because every table has RLS and every policy is a
# bare comparison on user_id. Safe to expose is not the same as a licence to
# skip RLS on a new table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses RLS entirely, so it must never be prefixed NEXT_PUBLIC_
# and never imported into a client component. Used by exactly one thing: the
# reminder cron, which has no session to run under and has to read across every
# user's deliveries.
#
# Project Settings > API Keys > Secret keys, the sb_secret_ one. Prefer it over
# the legacy service_role key: it is revocable on its own, where revoking the
# legacy JWT means rotating every key in the project. SUPABASE_SERVICE_ROLE_KEY
# is still read for a project that has not moved.
SUPABASE_SECRET_KEY=

# ── Reminders ───────────────────────────────────────────────────────────────

# The public origin, used for every link inside an email. On Vercel this can be
# left blank: the production domain is read from VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_APP_URL=

RESEND_API_KEY=
# onboarding@resend.dev only delivers to the address that owns the Resend
# account, which makes it a sandbox rather than a limitation. A real domain is
# this line plus the SPF, DKIM and DMARC records.
# No quotes. A stray one ends up inside the display name, and the only place that
# shows is the From line of a mail somebody already received.
EMAIL_FROM=Tend <onboarding@resend.dev>

# off | console | catchall | live. Defaults to live on a production deployment
# and off everywhere else, so a missing value fails safe. live outside
# production is refused unless EMAIL_ALLOW_LIVE=true.
EMAIL_MODE=console
# EMAIL_ALLOW_LIVE=
# Where catchall mode delivers. The original recipient goes in the subject.
# EMAIL_DEV_INBOX=
# Comma separated. Outside production nothing is sent to a domain not listed
# here, and an empty list blocks everything rather than allowing it.
# EMAIL_ALLOWED_DOMAINS=

# Signs unsubscribe links. Any long random string; `openssl rand -base64 32`.
# Rotating it invalidates every link already sitting in an inbox, which is the
# same effect as bumping user_settings.email_token_version.
EMAIL_TOKEN_SECRET=

# From the Resend webhook you point at /api/webhooks/resend. Without it the
# webhook refuses every request, which fails safe: no signature, no suppression.
RESEND_WEBHOOK_SECRET=

# From Authentication > Hooks > Send Email, which is what makes sign-in codes
# arrive in Tend's own design through Resend instead of Supabase's SMTP. Paste it
# exactly as the dashboard shows it, v1,whsec_ prefix and all. Without it the
# route refuses every request and no code is ever sent, so sign-in stops: turn
# the hook off in the dashboard to fall back to the default templates.
AUTH_EMAIL_HOOK_SECRET=

# Shared with Supabase Vault, which is where the tick reads it from:
#   select vault.create_secret('<this value>', 'tend_cron_secret');
#   select vault.create_secret('https://<app>/api/cron/reminders', 'tend_reminders_url');
# Vercel's own scheduler sends it as `Authorization: Bearer`, and pg_net sends it
# as x-cron-secret. Both are accepted.
CRON_SECRET=

# ── Notifications ───────────────────────────────────────────────────────────
# A browser push, which is the other half of the reminder pipeline. Postgres
# still decides who gets told and when; this is only how the message travels.
#
# Generate a pair once and keep it: `npx web-push generate-vapid-keys`.
# Rotating them invalidates every existing subscription, so every device has to
# turn notifications on again.
#
# The public key has to reach the browser, which is what the prefix is for. It is
# public by design and the server reads this same variable rather than a second
# copy of it. With either of these unset, push is simply off: the cron sends
# email exactly as it did before and nothing fails.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL a push service can use to reach whoever is sending.
# Defaults to the app's own origin, which is a valid answer.
# VAPID_SUBJECT=
